<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
	<TargetFramework>net7.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<UserSecretsId>NoSqlU.Api-LocalDevelopment</UserSecretsId>
	<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../frontend/Views/**/*.cshtml" Link="Views/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../frontend/css/**/*.css" Link="wwwroot/css/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
	<ProjectReference Include="..\Domain\Domain.csproj" />
	<ProjectReference Include="..\Data\Data.csproj" />
  </ItemGroup>
</Project>
