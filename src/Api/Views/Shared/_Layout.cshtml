<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Gestión de empleados</title>
    <link rel="stylesheet" href="/css/admin.css?v=6" />
</head>
<body>
    <div class="container">
        <aside class="sidebar">
            <div class="brand"><h2>Gestión de personal</h2><span>CONTROL DE EMPLEADOS</span></div>
            <nav class="menu">
                <a asp-controller="Admin" asp-action="Empleados" class="@(ViewData["Active"] as string == "Empleados" ? "active" : "")"><span aria-hidden="true">♙</span> Empleados</a>
                <a asp-controller="Admin" asp-action="Catalogos" class="@(ViewData["Active"] as string == "Catalogos" ? "active" : "")"><span aria-hidden="true">▤</span> Catálogos</a>
            </nav>
        </aside>
        <main class="main-content">
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="card" role="status">@mensaje</div>
            }
            @RenderBody()
        </main>
    </div>
</body>
</html>
