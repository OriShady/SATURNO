@model IReadOnlyList<Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    ViewData["Active"] = "Usuarios";
}
<header class="header"><h1>Gestión de usuarios</h1><p>Consulta y supervisa las cuentas registradas</p></header>
<section class="card">
    <div class="table-header"><div><h3>Usuarios registrados</h3><p class="section-description">Cuentas activas e inactivas</p></div><span class="badge-count">@Model.Count registros</span></div>
    <div class="table-actions"><span class="table-hint">Información actualizada desde el sistema</span><a asp-action="Registro" class="btn btn-primary">＋ Registrar usuario</a></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>ID</th><th>Nombre completo</th><th>Correo empresarial</th><th>Teléfono</th><th>Teléfono de emergencia</th><th>Capacidad diferente</th><th>Estatus</th><th>Acciones</th></tr></thead>
            <tbody>
            @if (Model.Count == 0) { <tr><td colspan="8">No hay usuarios registrados.</td></tr> }
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.Id</td><td>@usuario.Nombres @usuario.ApellidoPaterno @usuario.ApellidoMaterno</td>
                    <td>@usuario.CorreoEmpresarial</td><td>@(usuario.Telefono ?? "-")</td><td>@(usuario.TelefonoEmergencia ?? "-")</td>
                    <td>@(usuario.CapacidadDiferente?.Nombre ?? "-")</td>
                    <td><span class="status @usuario.Estatus.ToLowerInvariant()">@usuario.Estatus</span></td>
                    <td class="actions-cell">
                      <div class="user-row-actions">
                        <a asp-action="DetalleUsuario" asp-route-id="@usuario.Id" class="btn btn-secondary">Ver detalle</a>
                        <a asp-action="AsignarCurso" asp-route-id="@usuario.Id" class="btn btn-primary">Asignar curso</a>
                        <form asp-action="CambiarUsuarioEstatus" method="post" class="inline-form"><input type="hidden" name="id" value="@usuario.Id" /><button type="submit" class="status-action @(usuario.Estatus == "ACTIVO" ? "is-active" : "is-inactive")"><span class="status-action-icon" aria-hidden="true">@(usuario.Estatus == "ACTIVO" ? "−" : "+")</span>@(usuario.Estatus == "ACTIVO" ? "Desactivar" : "Reactivar")</button></form>
                      </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
