@model EmpleadosViewModel
@{
    ViewData["Title"] = "Buscar empleados";
    ViewData["Active"] = "Empleados";
}
<header class="header employee-heading">
    <h1>Empleados</h1>
    <a asp-action="RegistrarEmpleado" class="btn btn-primary">Nuevo empleado</a>
</header>
<section class="card">
    <form asp-action="Empleados" method="get">
        <div class="employee-fields employee-filter-fields">
            <div class="form-group"><label for="numero">Número de empleado</label><input id="numero" name="numero" type="number" min="1" value="@Model.Numero" /></div>
            <div class="form-group"><label for="q">Nombre</label><input id="q" name="q" value="@Model.Q" /></div>
            <div class="form-group"><label for="estatus">Estatus</label><select id="estatus" name="estatus">
                <option value="">Todos</option>
                <option value="ACTIVO" selected="@(Model.Estatus == "ACTIVO")">Activo</option>
                <option value="INACTIVO" selected="@(Model.Estatus == "INACTIVO")">Inactivo</option>
            </select></div>
            <div class="employee-filter-actions">
                <a asp-action="Empleados" class="btn btn-secondary">Limpiar</a>
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>
        </div>
    </form>
</section>

<section class="card">
    <div class="section-header table-header"><h2>Directorio de empleados</h2><span class="badge-count">@Model.TotalEmpleados registros</span></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>No. empleado</th><th>Nombre</th><th>Correo institucional</th><th>Estatus</th><th>Ingreso</th><th>Acciones</th></tr></thead>
            <tbody>
            @if (Model.Empleados.Count == 0)
            {
                <tr>
                    <td colspan="6">
                        <p class="employee-empty">@( !string.IsNullOrWhiteSpace(Model.Q) || Model.Estatus is not null || Model.Numero.HasValue
                            ? "No se encontraron empleados con esos filtros."
                            : "Todavía no hay empleados registrados.")</p>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var empleado in Model.Empleados)
                {
                    var activo = empleado.Estatus == "ACTIVO";
                    var nombre = $"{empleado.Nombres} {empleado.ApellidoPaterno} {empleado.ApellidoMaterno}".Trim();
                    <tr>
                        <td>@empleado.Id</td><td>@nombre</td><td>@empleado.CorreoEmpresarial</td>
                        <td>@(activo ? "Activo" : "Inactivo")</td><td>@empleado.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td><div class="employee-actions">
                            <a asp-action="DetalleUsuario" asp-route-id="@empleado.Id" class="btn btn-secondary">Detalles</a>
                            <a asp-action="EditarEmpleado" asp-route-id="@empleado.Id" class="btn btn-secondary">Editar</a>
                            @if (activo)
                            {
                                <form asp-action="CambiarUsuarioEstatus" method="post">
                                    <input type="hidden" name="id" value="@empleado.Id" />
                                    <input type="hidden" name="numero" value="@empleado.Id" />
                                    <button type="submit" class="btn btn-secondary">Dar de baja</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-danger" data-delete-id="@empleado.Id" data-delete-name="@nombre">Eliminar</button>
                            }
                        </div></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPaginas > 1)
    {
        <nav class="pagination" aria-label="Paginación de empleados">
            @if (Model.Pagina > 1)
            {
                <a asp-action="Empleados" asp-route-pagina="@(Model.Pagina - 1)" asp-route-numero="@Model.Numero" asp-route-q="@Model.Q" asp-route-estatus="@Model.Estatus" class="btn btn-secondary">Anterior</a>
            }
            <span>Página @Model.Pagina de @Model.TotalPaginas</span>
            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a asp-action="Empleados" asp-route-pagina="@(Model.Pagina + 1)" asp-route-numero="@Model.Numero" asp-route-q="@Model.Q" asp-route-estatus="@Model.Estatus" class="btn btn-secondary">Siguiente</a>
            }
        </nav>
    }
</section>
<dialog class="user-dialog" id="delete-employee">
    <h2>Eliminar empleado</h2>
    <p>Se eliminarán definitivamente los datos, domicilios y cursos de <strong id="delete-name"></strong>.</p>
    <form asp-action="EliminarEmpleado" method="post">
        <input type="hidden" id="delete-id" name="id" />
        <div class="form-footer">
            <button type="button" class="btn btn-secondary" id="cancel-delete" autofocus>Cancelar</button>
            <button type="submit" class="btn btn-danger">Eliminar</button>
        </div>
    </form>
</dialog>
<script>
(() => {
    const dialog = document.getElementById("delete-employee");
    document.querySelectorAll("[data-delete-id]").forEach(button => button.addEventListener("click", () => {
        document.getElementById("delete-id").value = button.dataset.deleteId;
        document.getElementById("delete-name").textContent = button.dataset.deleteName;
        dialog.showModal();
    }));
    document.getElementById("cancel-delete").addEventListener("click", () => dialog.close());
})();
</script>
