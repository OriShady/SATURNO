@model CursoCreateViewModel
@{
    ViewData["Title"] = "Alta de Curso";
    ViewData["Active"] = "Cursos";
}
<header class="header"><h1>Alta de Curso</h1><p>Registra un nuevo curso y asígnalo a su categoría, nivel e instructor</p></header>
<section class="card">
    <form asp-action="CrearCurso" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid">
            <div>
                <div class="form-group">
                    <label asp-for="CategoriaId">CATEGORÍA *</label>
                    <select asp-for="CategoriaId" required>
                        <option value="">Selecciona una categoría</option>
                        @foreach (var categoria in Model.Categorias) { <option value="@categoria.Id">@categoria.Nombre</option> }
                    </select>
                    <span asp-validation-for="CategoriaId"></span>
                </div>
                <div class="form-group"><label asp-for="Nombre">NOMBRE *</label><input asp-for="Nombre" required /><span asp-validation-for="Nombre"></span></div>
                <div class="form-group"><label asp-for="Descripcion">DESCRIPCIÓN *</label><textarea asp-for="Descripcion" required></textarea><span asp-validation-for="Descripcion"></span></div>
            </div>
            <div>
                <div class="form-group">
                    <label asp-for="Nivel">NIVEL *</label><input asp-for="Nivel" list="niveles" required />
                    <datalist id="niveles">@foreach (var nivel in Model.Niveles) { <option value="@nivel.Nombre"></option> }</datalist>
                    <span asp-validation-for="Nivel"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Instructor">INSTRUCTOR *</label><input asp-for="Instructor" list="instructores" required />
                    <datalist id="instructores">@foreach (var instructor in Model.Instructores) { <option value="@instructor.Nombre"></option> }</datalist>
                    <span asp-validation-for="Instructor"></span>
                </div>
                <div class="form-group"><label asp-for="Precio">PRECIO *</label><input asp-for="Precio" type="number" step="0.01" min="0.01" required /><span asp-validation-for="Precio"></span></div>
                <div class="form-group"><label asp-for="DuracionMinutos">DURACIÓN (MIN) *</label><input asp-for="DuracionMinutos" type="number" min="1" required /><span asp-validation-for="DuracionMinutos"></span></div>
                <div class="form-group"><label asp-for="FechaPublicacion">FECHA PUBLICACIÓN *</label><input asp-for="FechaPublicacion" type="date" required /><span asp-validation-for="FechaPublicacion"></span></div>
            </div>
        </div>
        <div class="form-footer"><a asp-action="Cursos" class="btn btn-secondary">Limpiar</a><button type="submit" class="btn btn-primary">Guardar Curso</button></div>
    </form>
</section>
