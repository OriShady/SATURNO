@model Usuario
@{
    ViewData["Title"] = "Detalles del empleado";
    ViewData["Active"] = "Empleados";
}
<header class="header employee-heading">
    <h1>@Model.Nombres @Model.ApellidoPaterno @Model.ApellidoMaterno</h1>
    <a asp-action="EditarEmpleado" asp-route-id="@Model.Id" class="btn btn-primary">Editar empleado</a>
</header>
<section class="card">
    <h2>Datos</h2>
    <dl class="user-detail-grid">
        <div><dt>Número de empleado</dt><dd>@Model.Id</dd></div>
        <div><dt>Fecha de nacimiento</dt><dd>@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd></div>
        <div><dt>Fecha de ingreso</dt><dd>@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd></div>
        <div><dt>Sexo</dt><dd>@(Model.Sexo?.Descripcion ?? "—")</dd></div>
        <div><dt>Correo institucional</dt><dd>@Model.CorreoEmpresarial</dd></div>
        <div><dt>Celular</dt><dd>@(Model.Telefono ?? "—")</dd></div>
        <div><dt>Estatus</dt><dd>@(Model.Estatus == "ACTIVO" ? "Activo" : "Inactivo")</dd></div>
    </dl>
</section>
<section class="card">
    <h2>Domicilio</h2>
    @foreach (var direccion in Model.Direcciones)
    {
        <p>@direccion.Calle @direccion.NumeroExterior @direccion.NumeroInterior, C. P. @direccion.CodigoPostal, @direccion.Estado?.NombreEstado</p>
    }
</section>
<section class="card">
    <h2>Cursos</h2>
    @if (Model.CursosUsuarios.Count == 0)
    {
        <p>Sin cursos registrados.</p>
    }
    else
    {
        <div class="table-wrap"><table class="data-table">
            <thead><tr><th>Curso</th><th>Duración (minutos)</th><th>Inicio</th><th>Entrega de constancia</th></tr></thead>
            <tbody>
            @foreach (var curso in Model.CursosUsuarios)
            {
                <tr><td>@curso.NombreCurso</td><td>@(curso.DuracionMinutos?.ToString() ?? "—")</td><td>@(curso.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")</td><td>@((curso.FechaEntregaConstancia ?? curso.FechaFinalizacion)?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
            }
            </tbody>
        </table></div>
    }
</section>
<a asp-action="Empleados" asp-route-numero="@Model.Id" class="btn btn-secondary">Volver a empleados</a>
