<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Gestión de empleados</title>
    <link rel="stylesheet" href="/css/admin.css?v=11" />
</head>
<body>
    <div class="container">
        <aside class="sidebar">
            <div class="brand"><h2>Personal</h2></div>
            <nav class="menu">
                <a asp-controller="Empleados" asp-action="Empleados" class="@(ViewData["Active"] as string == "Empleados" ? "active" : "")"><span aria-hidden="true">♙</span> Empleados</a>
                <a asp-controller="Catalogos" asp-action="Catalogos" class="@(ViewData["Active"] as string == "Catalogos" ? "active" : "")"><span aria-hidden="true">▤</span> Catálogos</a>
                <form asp-controller="Sesion" asp-action="Salir" method="post">
                    <button type="submit" class="menu-signout">Salir</button>
                </form>
            </nav>
        </aside>
        <main class="main-content">
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="card" role="status">@mensaje</div>
            }
            @RenderBody()
        </main>
    </div>
</body>
</html>
